{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "rootDir": ".",
    "outDir": ".generated"
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [".generated", "previews"]
}
