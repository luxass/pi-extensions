{
  "name": "@luxass/pi-whimsical",
  "version": "0.1.0",
  "description": "Playful working messages for Pi",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/luxass/pi-extensions",
    "directory": "packages/whimsical"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/whimsical.ts"
    ]
  }
}
